# *_PORT values are host-side ports of the compose mappings

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_dev
POSTGRES_PORT=5432
POSTGRES_DB=user_db

# ── Redis ───────────────────────────────────────────────────
REDIS_PORT=6380

# ── Kafka (KRaft mode) ─────────────────────────────────────
KAFKA_PORT=9092

# ── Shared secrets ──────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production-min-32
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-in-prod

# ── user-service seed ───────────────────────────────────────
ADMIN_PASSWORD=admin123

# ── payment-service ─────────────────────────────────────────
# Stripe test mode only: a key that does not start with sk_test_ fails startup
STRIPE_SECRET_KEY=sk_test_replace_me
# pm_card_chargeDeclined exercises the failure path
STRIPE_TEST_PAYMENT_METHOD=pm_card_visa

# ── Optional (defaults shown) ───────────────────────────────
# RATE_LIMIT_ANONYMOUS=30
# RATE_LIMIT_AUTHENTICATED=100
# UPSTREAM_TIMEOUT_MS=10000
# Set to true only behind a trusted reverse proxy (X-Forwarded-For)
# TRUST_PROXY=false
# EMAIL_FROM="E-commerce" <no-reply@ecommerce.local>
