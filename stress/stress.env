# Host ports shifted so the stress world runs alongside `pnpm dev`
GATEWAY_PORT=4000
POSTGRES_PORT=6432
REDIS_PORT=7380
KAFKA_PORT=10092
MAILPIT_SMTP_PORT=2025
MAILPIT_UI_PORT=9025
PROMETHEUS_PORT=10090
GRAFANA_PORT=4100
TOXIPROXY_PORT=9474

# Requests per minute; the limiter stays in the request path but never decides an attack
RATE_LIMIT_ANONYMOUS=1000000
RATE_LIMIT_AUTHENTICATED=1000000

# Load measures the platform, not Stripe; the baseline mimics a PSP round trip
PAYMENT_PROCESSOR=fake
FAKE_PAYMENT_LATENCY_MS=200
FAKE_PAYMENT_JITTER_MS=100
FAKE_PAYMENT_FAILURE_RATE=0
